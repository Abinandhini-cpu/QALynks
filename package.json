{
  "name": "qalynks",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "QALynks: AI-powered QA management platform. Module 1: Test Case Management.",
  "engines": {
    "node": ">=22.5.0"
  },
  "workspaces": [
    "packages/*",
    "apps/*"
  ],
  "scripts": {
    "dev": "concurrently -n api,web -c blue,green \"npm run dev -w @qalynks/api\" \"npm run dev -w @qalynks/web\"",
    "db:migrate": "npm run db:migrate -w @qalynks/api",
    "db:seed": "npm run db:seed -w @qalynks/api",
    "db:reset": "npm run db:reset -w @qalynks/api",
    "build": "npm run build -w @qalynks/web",
    "typecheck": "npm run typecheck --workspaces --if-present",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "npm run test --workspaces --if-present",
    "test:coverage": "npm run test:coverage --workspaces --if-present",
    "e2e": "playwright test",
    "audit:deps": "npm audit --audit-level=high",
    "check": "npm run format:check && npm run lint && npm run typecheck && npm run test:coverage && npm run audit:deps"
  },
  "devDependencies": {
    "@eslint/js": "^9.0.0",
    "@playwright/test": "^1.50.0",
    "@vitest/coverage-v8": "^5.0.0",
    "concurrently": "^9.0.0",
    "eslint": "^9.0.0",
    "eslint-plugin-jsx-a11y": "^6.10.0",
    "eslint-plugin-react-hooks": "^5.2.0",
    "globals": "^16.0.0",
    "prettier": "^3.0.0",
    "typescript": "~5.9.0",
    "typescript-eslint": "^8.0.0",
    "vitest": "^5.0.0"
  }
}
