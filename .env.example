# Copy to .env to override defaults. Defaults work without this file.
# API server
PORT=3001
HOST=127.0.0.1
# SQLite file path. Relative paths resolve from the apps/api directory.
DATABASE_PATH=data/qalynks.db
# Set to "silent" to quiet request logs.
LOG_LEVEL=info

# AI test case generation (optional). Leave the key empty to disable it.
# Never commit a real key. .env is git-ignored.
ANTHROPIC_API_KEY=
# AI_MODEL=claude-sonnet-5-5
# AI_TIMEOUT_MS=120000
# AI_MAX_REQUESTS_PER_MINUTE=10
